NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Lead notification
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=start@arturosolo.com

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe Checkout (workshop $97 and alumni Assessment $1,200)
# Create two one-time Prices in Stripe. Do not reuse a $1,500 Assessment price for alumni.
STRIPE_SECRET_KEY=
STRIPE_PRICE_WORKSHOP=
STRIPE_PRICE_ALUMNI_ASSESSMENT=
SITE_URL=https://arturosolo.com
# ISO-8601 class start. Alumni $1,200 stays open until 24 hours after this instant.
# If unset, the alumni window is 24 hours from workshop payment (placeholder).
WORKSHOP_START_AT=
